{
  "name": "@ems/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "migrate": "node --env-file=.env.admin scripts/migrate.js",
    "grant:runtime": "node --env-file=.env.admin scripts/grant-runtime.js",
    "setup:local": "node scripts/setup-local.js",
    "bootstrap:ceo": "node --env-file=.env scripts/bootstrap-ceo.js",
    "cleanup:expired": "node --env-file=.env scripts/cleanup-expired.js",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
