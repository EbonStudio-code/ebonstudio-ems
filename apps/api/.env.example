NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Set only after ensuring clients cannot bypass the reviewed reverse proxy.
TRUST_PROXY_HOPS=0
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=employee_management_dev
PGUSER=ems_app
PGPASSWORD=replace-locally
ENABLED_MODULES=holidays,attendance,leave,tasks,complaints,salary-slips
# disabled sends nothing; preview writes sensitive local setup/reset links.
# Production supports MAIL_MODE=resend or smtp. Resend uses a durable queue.
MAIL_MODE=disabled
MAIL_PREVIEW_DIR=.local-mail
# Required for production; use a stable random secret of at least 32 characters.
RATE_LIMIT_SECRET=
# Production readiness probe must supply this as X-Readiness-Key.
READINESS_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# RESEND_API_KEY=
# MAIL_FROM_DOMAIN=notify.ebonstudio.com
# MAIL_FROM=Ebon Studio EMS <no-reply@notify.ebonstudio.com>
# MAIL_OUTBOX_KEY=64-random-hex-characters
# HR_NOTIFICATIONS_ENABLED=false
# Container entrypoint also supports SECRET_NAME_FILE for mounted secret files.
# Local font file with the character coverage your statements need:
# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
# Only needed for the one-time bootstrap command. Never commit real addresses.
# BOOTSTRAP_CEO_NAME=
# BOOTSTRAP_CEO_EMAIL=
