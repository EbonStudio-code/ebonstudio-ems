# Shell-sourced by the approved SSH deployment command. Nonsecret, operator-owned.
# Copy to /opt/ems/shared/deploy-policy.env only after authorization; never Git.
EMS_PROJECT=ems-prod
# Preserve the approved current mode on upgrades. Changing ingress is separate.
EMS_INGRESS=isolated
EMS_BACKUP_DIR=/var/backups/ems
EMS_BACKUP_RECIPIENT=REPLACE_WITH_APPROVED_AGE_PUBLIC_RECIPIENT
EMS_RECOVERY_REPORT=/opt/ems/shared/recovery-reviewed.txt
# Empty ONLY for first deployment. Before upgrades select the last healthy release.
EMS_PREVIOUS_RELEASE=
