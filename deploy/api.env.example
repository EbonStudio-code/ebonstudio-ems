## Copy ONLY this nonsecret settings template to the protected guest api.env.
## This stack uses Resend; the mail worker does not support SMTP mode.
MAIL_MODE=resend
MAIL_FROM=Ebon Studio EMS <no-reply@notify.ebonstudio.com>
MAIL_FROM_DOMAIN=notify.ebonstudio.com
# Enable only after business approval of generic notifications:
HR_NOTIFICATIONS_ENABLED=false
ENABLED_MODULES=holidays,attendance,leave,tasks,complaints,salary-slips
# The remaining backend variables are fixed by deploy/compose.yaml, not duplicated:
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# APP_ORIGIN=https://ems.ebonstudio.com
# TRUST_PROXY_HOPS=1
# PGHOST=db
# PGPORT=5432
# PGDATABASE=ems
# PGUSER=ems_app
# PGSSLMODE=disable
# PDF_FONT_PATH=/opt/ems-fonts/DejaVuSans.ttf
# PGPASSWORD_FILE=/run/secrets/db_app_password
# RATE_LIMIT_SECRET_FILE=/run/secrets/rate_limit_secret
# READINESS_SECRET_FILE=/run/secrets/readiness_secret
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# MAIL_OUTBOX_KEY_FILE=/run/secrets/mail_outbox_key
# Never set the matching direct secret variable as well as its *_FILE variable.
# Frontend uses same-origin /api/v1; there are no production VITE_* secrets.
