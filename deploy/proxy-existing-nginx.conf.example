# Review only. Do not replace any existing proxy configuration.
# Add a dedicated virtual host ONLY after approval. TLS paths are examples.
server {
    listen 443 ssl;
    server_name ems.ebonstudio.com;
    ssl_certificate /approved/path/fullchain.pem;
    ssl_certificate_key /approved/path/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/ems-error.log crit;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host ems.ebonstudio.com;
        proxy_set_header X-Real-IP $remote_addr;
        # Strip client-controlled Cloudflare/forwarding headers in direct ingress.
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 35s;
    }
}
# Add an HTTP->HTTPS redirect only if the existing ingress owner approves.
