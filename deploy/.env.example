# Nonsecret release manifest. Use absolute paths on the Debian guest.
EMS_RUNTIME_DIR=/opt/ems/shared
EMS_API_IMAGE=ghcr.io/OWNER/ebonstudio-ems-api@sha256:REPLACE_WITH_TESTED_DIGEST
EMS_WEB_IMAGE=ghcr.io/OWNER/ebonstudio-ems-web@sha256:REPLACE_WITH_TESTED_DIGEST
EMS_DB_IMAGE=ghcr.io/OWNER/ebonstudio-ems-db@sha256:REPLACE_WITH_TESTED_DIGEST
EMS_HTTP_PORT=18080
# Only for approved Tunnel ingress:
# EMS_TUNNEL_IMAGE=cloudflare/cloudflared@sha256:REPLACE_WITH_VERIFIED_DIGEST
